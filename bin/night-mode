#!/usr/bin/env bash
# night-mode: dim every screen to the same real brightness.
#
# A brightness percentage means something different on every screen: 5 % on a
# 400 cd/m² laptop panel is far brighter than 5 % on a 250 cd/m² monitor. Night
# mode works in cd/m² (nits) instead. It reads how bright each screen can get
# from the screen's own EDID, picks one target luminance, and sets every screen
# to the level that gives it. By default the target is the dimmest light the
# least-dimmable screen can give at 1 %, so every screen can reach it.
#
# https://github.com/JackRubiralta/omarchy-night-mode · MIT licence

set -uo pipefail
shopt -s nullglob

readonly VERSION="1.2.0"
readonly PLUGIN_ID="io.github.jackrubiralta.night-mode"

SYSFS="${NIGHT_MODE_SYSFS:-/sys}"
STATE_DIR="${NIGHT_MODE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/night-mode}"
STATE="$STATE_DIR/state.json"
SHELL_JSON="${NIGHT_MODE_SHELL_JSON:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json}"
BRIGHTNESS_LOCK="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display.lock"

# EDID says how bright a screen gets at full brightness, but not how bright a
# monitor dimmed over DDC/CI still is at 0 %: its backlight never switches off.
# Night mode assumes that floor is 5 % of the maximum (calibrate to correct it).
readonly PERCENT_FLOOR="0.05"
# Used only when a screen's EDID carries no luminance at all.
readonly FALLBACK_INTERNAL_NITS=300
readonly FALLBACK_EXTERNAL_NITS=250
# One calibration step changes a screen's luminance by this factor.
readonly CALIBRATE_STEP="1.08"

usage() {
  cat <<EOF
Usage: night-mode [command]

  toggle           Turn night mode on or off (default)
  on | off         Turn night mode on or off
  status           Print "on" or "off"
  sync             Bring every connected screen to what night mode is now:
                   dim it when on, give it its own level back when off
                   (exits 75 when a screen did not answer yet)
  info [--json]    Show every screen, its luminance and its night level
  calibrate        Match a screen to the others by eye (needs a terminal)
  forget [screen]  Forget one screen's data and calibration, or all of them
  version          Print the version

Settings live in the widget's entry in ~/.config/omarchy/shell.json:
  "brightness": cd/m² while night mode is on (0 = automatic)
  "keyboard":   "dim", "off" or "unchanged"
EOF
}

die() { echo "night-mode: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# --- numbers -----------------------------------------------------------------

calc() { awk "BEGIN { printf \"%.4f\", $1 }"; }
round() { awk -v x="$1" 'BEGIN { printf "%d", (x < 0 ? x - 0.5 : x + 0.5) }'; }
fmt_nits() { awk -v x="$1" 'BEGIN { if (x >= 10) printf "%.0f", x; else printf "%.1f", x }'; }

# IEEE 754 half-precision float from two little-endian bytes (DisplayID 2.x).
half_float() {
  awk -v lo="$1" -v hi="$2" 'BEGIN {
    v = hi * 256 + lo; s = int(v / 32768); e = int(v / 1024) % 32; m = v % 1024
    if (e == 0) x = m / 1024 * 2 ^ -14
    else if (e == 31) x = 0
    else x = (1 + m / 1024) * 2 ^ (e - 15)
    printf "%.4f", (s ? -x : x)
  }'
}

# CTA-861 HDR static metadata code value to cd/m².
cta_luminance() { awk -v cv="$1" 'BEGIN { printf "%.4f", 50 * 2 ^ (cv / 32) }'; }

plausible_max() { awk -v x="$1" 'BEGIN { exit !(x >= 50 && x <= 10000) }'; }

# --- EDID --------------------------------------------------------------------

# sysfs reports every file as 0 bytes, so test for content by reading it.
has_bytes() { [[ -r $1 ]] && [[ -n $(od -An -tx1 -N1 "$1" 2>/dev/null) ]]; }

# Print "<cd/m²>\t<source>" for the white luminance of a screen at full
# brightness, from the best field its EDID carries:
#   1. DisplayID 2.1 brightness luminance range: maximum suggested SDR luminance
#   2. DisplayID 2.0 display parameters: native maximum luminance, full coverage
#   3. CTA-861 HDR static metadata: maximum frame-average luminance
#   4. CTA-861 HDR static metadata: maximum luminance
edid_luminance() {
  local file=$1 b n blk i end tag len plen
  local range="" params="" cta_avg="" cta_max=""
  has_bytes "$file" || return 1
  read -r -a b < <(od -An -v -tu1 "$file" | tr -s ' \n' ' ')
  n=${#b[@]}
  (( n >= 256 )) || return 1

  for (( blk = 128; blk + 128 <= n; blk += 128 )); do
    case ${b[blk]} in
    2) # CTA-861 extension: data blocks run from byte 4 to the DTD offset.
      end=$(( blk + b[blk + 2] ))
      (( b[blk + 2] < 4 || b[blk + 2] > 127 )) && end=$(( blk + 4 ))
      for (( i = blk + 4; i < end; i += 1 + len )); do
        tag=$(( b[i] >> 5 )); len=$(( b[i] & 31 ))
        if (( tag == 7 && len >= 5 && i + 5 < end && b[i + 1] == 6 )); then
          (( len >= 5 && b[i + 5] > 0 )) && cta_avg=$(cta_luminance "${b[i + 5]}")
          (( b[i + 4] > 0 )) && cta_max=$(cta_luminance "${b[i + 4]}")
        fi
      done
      ;;
    112) # DisplayID extension: blocks start at byte 5, each tag, revision, length.
      end=$(( blk + 5 + b[blk + 2] ))
      (( end > blk + 127 )) && end=$(( blk + 127 ))
      for (( i = blk + 5; i + 3 <= end; i += 3 + plen )); do
        tag=${b[i]}; plen=${b[i + 2]}
        (( tag == 0 && plen == 0 )) && break
        (( i + 3 + plen <= blk + 128 )) || break
        case $tag in
        46) # 0x2E brightness luminance range: min SDR, max SDR, max boost
          (( plen >= 4 )) && range=$(half_float "${b[i + 5]}" "${b[i + 6]}") ;;
        33) # 0x21 display parameters: max luminance (full coverage) at offset 21
          (( plen >= 23 )) && params=$(half_float "${b[i + 24]}" "${b[i + 25]}") ;;
        esac
      done
      ;;
    esac
  done

  pick() { [[ -n $1 ]] && plausible_max "$1" && printf '%s\t%s\n' "$1" "$2"; }
  pick "$range" "EDID brightness range" ||
    pick "$params" "EDID display parameters" ||
    pick "$cta_avg" "EDID HDR frame average" ||
    pick "$cta_max" "EDID HDR maximum"
}

# Manufacturer, product and serial (EDID bytes 8-15): the same monitor model
# shares its data and calibration on any port.
edid_key() {
  has_bytes "$1" || return 1
  od -An -v -tx1 -j8 -N8 "$1" | tr -d ' \n'
}

edid_file() {
  local f
  for f in "$SYSFS"/class/drm/card*-"$1"/edid; do
    has_bytes "$f" && { printf '%s\n' "$f"; return 0; }
  done
  return 1
}

# --- settings and state ------------------------------------------------------

setting() {
  local key=$1 fallback=$2 value=""
  [[ -r $SHELL_JSON ]] && value=$(jq -r --arg id "$PLUGIN_ID" --arg key "$key" '
    [.bar.layout? // {} | .[]? | arrays | .[] | objects | select(.id == $id)][0][$key] // empty
  ' "$SHELL_JSON" 2>/dev/null)
  printf '%s\n' "${value:-$fallback}"
}

target_setting() {
  local v=${NIGHT_MODE_BRIGHTNESS:-$(setting brightness 0)}
  [[ $v =~ ^[0-9]+([.][0-9]+)?$ ]] || v=0
  printf '%s\n' "$v"
}

keyboard_setting() {
  local v=${NIGHT_MODE_KEYBOARD:-$(setting keyboard dim)}
  case $v in dim | off | unchanged) printf '%s\n' "$v" ;; *) printf 'dim\n' ;; esac
}

S='{}'
load_state() {
  S='{}'
  [[ -s $STATE ]] && S=$(jq -c '.' "$STATE" 2>/dev/null) || S='{}'
  [[ -n $S ]] || S='{}'
  # Saved levels belong to a screen, not a port. Up to 1.1 they were filed under
  # the connector; such an entry gets its connector recorded here, and `scan`
  # moves it to its screen's id when that screen next shows up, on any port.
  S=$(jq -c '{on: (.on // false), target: .target, reference: .reference,
    saved: (.saved // {} | with_entries(.value.connector //= .key)),
    keyboard: .keyboard, displays: (.displays // {})}' <<<"$S")
  migrate_v0
}

save_state() {
  local tmp
  mkdir -p "$STATE_DIR"
  tmp=$(mktemp "$STATE_DIR/.state.XXXXXX") || die "cannot write $STATE_DIR"
  jq '.' <<<"$S" >"$tmp" && mv -f "$tmp" "$STATE"
}

js() { S=$(jq -c "$@" <<<"$S"); }

# Earlier versions kept "display <name> <percent>" and "kbd <device> <value>"
# lines in $STATE_DIR/saved; carry them over so turning off still restores.
migrate_v0() {
  local old="$STATE_DIR/saved" kind name val
  [[ -f $old ]] || return 0
  while read -r kind name val; do
    [[ $val =~ ^[0-9]+$ ]] || continue
    case $kind in
    display) js --arg c "$name" --argjson v "$val" '.saved[$c] = {kind: "percent", level: $v, setLevel: null, key: null, connector: $c}' ;;
    kbd) js --arg d "$name" --argjson v "$val" '.keyboard = {device: $d, level: $v}' ;;
    esac
  done <"$old"
  js '.on = true'
  save_state && rm -f "$old"
}

# --- screens -----------------------------------------------------------------

declare -A D_KEY D_ID D_DESC D_KIND D_DEV D_MAX D_NITS D_SRC
CONNECTED=()

backlight_device() {
  local dev=""
  if have omarchy-hw-display; then
    dev=$(OMARCHY_BACKLIGHT_PATH="$SYSFS/class/backlight" omarchy-hw-display 2>/dev/null) || dev=""
  fi
  if [[ -z $dev ]]; then
    local d
    for d in "$SYSFS"/class/backlight/*; do dev=${d##*/}; break; done
  fi
  [[ -n $dev && -r $SYSFS/class/backlight/$dev/max_brightness ]] && printf '%s\n' "$dev"
}

is_internal() { [[ $1 =~ ^(eDP|LVDS|DSI)- ]]; }

# Fill the D_* tables for every enabled monitor, plus a laptop panel switched
# off with its lid closed (its backlight still answers, and it should already
# be right when the lid opens). Nothing here talks DDC/CI.
scan() {
  local monitors name desc disabled edid lum key bl
  have hyprctl || die "hyprctl not found (night mode needs Hyprland)"
  monitors=$(hyprctl monitors all -j 2>/dev/null) || die "cannot reach Hyprland"
  CONNECTED=()
  bl=$(backlight_device) || bl=""
  while IFS=$'\t' read -r name desc disabled; do
    [[ -n $name ]] || continue
    if [[ $disabled == true ]] && ! { is_internal "$name" && [[ -n $bl ]]; }; then
      continue
    fi
    CONNECTED+=("$name")
    D_DESC[$name]=$desc
    edid=$(edid_file "$name") || edid=""
    key=$(edid_key "$edid" 2>/dev/null) || key=""
    D_KEY[$name]=${key:-connector:$name}

    if is_internal "$name" && [[ -n $bl ]]; then
      D_KIND[$name]=backlight
      D_DEV[$name]=$bl
      D_MAX[$name]=$(<"$SYSFS/class/backlight/$bl/max_brightness")
    else
      D_KIND[$name]=percent
      D_DEV[$name]=""
      D_MAX[$name]=100
    fi

    if lum=$(edid_luminance "$edid" 2>/dev/null); then
      D_NITS[$name]=${lum%%$'\t'*}
      D_SRC[$name]=${lum#*$'\t'}
    elif is_internal "$name"; then
      D_NITS[$name]=$FALLBACK_INTERNAL_NITS; D_SRC[$name]="no EDID data, typical laptop value"
    else
      D_NITS[$name]=$FALLBACK_EXTERNAL_NITS; D_SRC[$name]="no EDID data, typical monitor value"
    fi
  done < <(jq -r '.[] | [.name, ([.make, .model] | map(select(. != null and . != "")) | join(" ") | if . == "" then (.description // "") else . end), (.disabled == true)] | @tsv' <<<"$monitors")

  # A screen's id is its EDID identity, so its saved level follows it from
  # port to port. Two identical monitors plugged in at once (same EDID) are
  # told apart by their ports.
  local c n
  declare -A count=()
  for c in "${CONNECTED[@]}"; do count[${D_KEY[$c]}]=$(( ${count[${D_KEY[$c]}]:-0} + 1 )); done
  for c in "${CONNECTED[@]}"; do
    n=${count[${D_KEY[$c]}]}
    if (( n > 1 )); then D_ID[$c]="${D_KEY[$c]}@$c"; else D_ID[$c]=${D_KEY[$c]}; fi
  done
  claim_saved
}

# Give each connected screen the saved level it left behind, wherever it was
# filed: under its id; under the port it used before (1.1 state); or, when it
# comes back on another port or two identical monitors swap, any entry with
# its EDID identity that no other connected screen owns. Saved levels of
# screens that are away stay untouched until they come back.
claim_saved() {
  local c screens=()
  for c in "${CONNECTED[@]}"; do
    screens+=("$(jq -cn --arg id "${D_ID[$c]}" --arg key "${D_KEY[$c]}" --arg c "$c" '{id: $id, key: $key, connector: $c}')")
  done
  (( ${#screens[@]} )) || return 0
  js --argjson screens "$(printf '%s\n' "${screens[@]}" | jq -cs '.')" '
    ($screens | map(.id)) as $owned
    | reduce $screens[] as $s (.;
        if .saved[$s.id] then .saved[$s.id].connector = $s.connector
        else
          ([.saved | to_entries[]
            | select(.key as $id | $owned | index($id) | not)
            | select(.value.key == $s.key or (.value.key == null and .value.connector == $s.connector))]
           | sort_by(if .value.connector == $s.connector then 0 else 1 end) | first) as $e
          | if $e then .saved |= (del(.[$e.key]) + {($s.id): ($e.value + {key: $s.key, connector: $s.connector})})
            else . end
        end)'
}

# The saved entry of a connected screen.
has_saved() { jq -e --arg id "${D_ID[$1]}" '.saved[$id]' <<<"$S" >/dev/null; }
saved_field() { jq -r --arg id "${D_ID[$1]}" --arg f "$2" '.saved[$id][$f] // "" | tostring' <<<"$S"; }

lowest_level() {
  local c=$1
  if [[ ${D_KIND[$c]} == backlight ]]; then
    awk -v m="${D_MAX[$c]}" 'BEGIN { l = int((m + 99) / 100); print (l < 1 ? 1 : l) }'
  else
    echo 1
  fi
}

# cd/m² a screen gives at a level, under its model.
nits_at() {
  local c=$1 level=$2
  if [[ ${D_KIND[$c]} == backlight ]]; then
    calc "${D_NITS[$c]} * $level / ${D_MAX[$c]}"
  else
    calc "${D_NITS[$c]} * ($PERCENT_FLOOR + (1 - $PERCENT_FLOOR) * $level / 100)"
  fi
}

# Level that gives a luminance, clamped to what the screen can do.
level_for() {
  local c=$1 nits=$2 lo raw max=${D_MAX[$1]}
  lo=$(lowest_level "$c")
  if [[ ${D_KIND[$c]} == backlight ]]; then
    raw=$(round "$(calc "$nits / ${D_NITS[$c]} * ${D_MAX[$c]}")")
  else
    raw=$(round "$(calc "($nits / ${D_NITS[$c]} - $PERCENT_FLOOR) / (1 - $PERCENT_FLOOR) * 100")")
  fi
  (( raw < lo )) && raw=$lo
  (( raw > max )) && raw=$max
  echo "$raw"
}

wait_brightness_lock() {
  # omarchy-brightness-display skips silently while another run holds its lock.
  [[ -e $BRIGHTNESS_LOCK ]] && have flock && flock -w 2 "$BRIGHTNESS_LOCK" true 2>/dev/null
  return 0
}

warn() { echo "night-mode: $*" >&2; }

# A monitor that has just been plugged in, or woken with the laptop, can take
# several seconds to answer DDC/CI. When it misses one read, Omarchy's DDC
# helper marks it unavailable and refuses every call for the next 60 s, which
# would swallow every retry. For a monitor that has answered before, clear
# that mark so each try really asks the monitor.
ddc_unblock() {
  local c=$1 f word
  [[ $(jq -r --arg k "${D_KEY[$c]:-}" '.displays[$k].controllable // ""' <<<"$S") == true ]] || return 0
  f="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display-ddc/${c//[^[:alnum:]_.-]/_}.bus"
  [[ -r $f ]] && read -r word _ <"$f" && [[ $word == unavailable ]] && rm -f "$f"
  return 0
}

get_level() {
  local c=$1 kind=${2:-${D_KIND[$1]}} dev=${3:-${D_DEV[$1]:-}} v
  if [[ $kind == backlight ]]; then
    v=$(<"$SYSFS/class/backlight/$dev/brightness") || return 1
  else
    have omarchy-brightness-display || return 1
    wait_brightness_lock
    ddc_unblock "$c"
    v=$(omarchy-brightness-display --monitor "$c" 2>/dev/null) || return 1
  fi
  [[ $v =~ ^[0-9]+$ ]] || return 1
  echo "$v"
}

set_level() {
  local c=$1 level=$2 kind=${3:-${D_KIND[$1]:-percent}} dev=${4:-${D_DEV[$1]:-}}
  if [[ $kind == backlight ]]; then
    brightnessctl -q -c backlight -d "$dev" set "$level" >/dev/null 2>&1
  else
    wait_brightness_lock
    ddc_unblock "$c"
    omarchy-brightness-display --no-osd --monitor "$c" "${level}%" >/dev/null 2>&1
  fi
}

# Set a level and read it back, up to three times: a monitor can miss a DDC/CI
# command, and omarchy-brightness-display skips a run while another holds its
# lock, both without an error.
apply_level() {
  local c=$1 level=$2 kind=${3:-${D_KIND[$1]:-percent}} dev=${4:-${D_DEV[$1]:-}} try got
  for try in 1 2 3; do
    set_level "$c" "$level" "$kind" "$dev"
    if got=$(get_level "$c" "$kind" "$dev"); then
      # A percentage read back over DDC/CI can round one step either way.
      if [[ $kind == backlight ]] && (( got == level )); then return 0; fi
      if [[ $kind != backlight ]] && (( got - level <= 1 && level - got <= 1 )); then return 0; fi
    fi
    (( try < 3 )) && sleep "0.$(( try * 3 ))"
  done
  return 1
}

# A saved level in this screen's units (the 1.0 prototype saved percentages).
in_units() {
  local c=$1 kind=$2 v=$3
  if [[ $kind == "${D_KIND[$c]}" ]]; then
    echo "$v"
  elif [[ ${D_KIND[$c]} == backlight ]]; then
    round "$(calc "$v * ${D_MAX[$c]} / 100")"
  else
    round "$(calc "$v * 100 / ${D_MAX[$c]}")"
  fi
}

min() { if (( $1 < $2 )); then echo "$1"; else echo "$2"; fi; }

# Record what the connected screens are, keeping each one's calibration.
remember_screens() {
  local c lowest
  for c in "${CONNECTED[@]}"; do
    lowest=$(nits_at "$c" "$(lowest_level "$c")")
    js --arg k "${D_KEY[$c]}" --arg c "$c" --arg d "${D_DESC[$c]}" --arg kind "${D_KIND[$c]}" \
      --argjson max "${D_NITS[$c]}" --arg src "${D_SRC[$c]}" --argjson low "$lowest" \
      --arg seen "$(date +%F)" '
      .displays[$k] = ((.displays[$k] // {trim: 1, controllable: null}) + {
        name: $d, connector: $c, control: $kind, maxNits: $max, source: $src,
        nitsAtLowest: $low, lastSeen: $seen })'
  done
}

# A screen that has answered once stays controllable: one missed read (a
# monitor still waking up) must not drop it from the target, or every other
# screen would be dimmed further until the next replug.
mark_controllable() {
  js --arg k "${D_KEY[$1]}" --argjson ok "$2" '
    if .displays[$k] and ($ok or .displays[$k].controllable != true)
    then .displays[$k].controllable = $ok else . end'
}

trim_of() { jq -r --arg k "${D_KEY[$1]}" '.displays[$k].trim // 1' <<<"$S"; }

# Night luminance: the setting, or the brightest "lowest" of every screen that
# night mode has dimmed before, so the target holds when that screen is away.
compute_target() {
  local fixed
  fixed=$(target_setting)
  if awk -v x="$fixed" 'BEGIN { exit !(x > 0) }'; then
    js --argjson t "$fixed" '.target = $t | .reference = null'
    return
  fi
  js '
    ([.displays | to_entries[] | select(.value.controllable != false)] | max_by(.value.nitsAtLowest)) as $ref
    | if $ref then .target = $ref.value.nitsAtLowest | .reference = $ref.key
      else .target = 5 | .reference = null end'
}

target_nits() { jq -r '.target // 5' <<<"$S"; }
reference_key() { jq -r '.reference // ""' <<<"$S"; }

night_level() {
  local c=$1 trim
  trim=$(trim_of "$c")
  level_for "$c" "$(calc "$(target_nits) * $trim")"
}

# --- keyboard ----------------------------------------------------------------

keyboard_device() {
  local d
  for d in "$SYSFS"/class/leds/*kbd_backlight*; do
    [[ -r $d/brightness ]] && { printf '%s\n' "${d##*/}"; return 0; }
  done
  return 1
}

keyboard_on() {
  local mode dev cur
  mode=$(keyboard_setting)
  [[ $mode == unchanged ]] && return 0
  dev=$(keyboard_device) || return 0
  cur=$(<"$SYSFS/class/leds/$dev/brightness") || return 0
  if [[ $(jq -r '.keyboard.device // ""' <<<"$S") != "$dev" ]]; then
    js --arg d "$dev" --argjson v "$cur" '.keyboard = {device: $d, level: $v}'
  fi
  # Lowest lit step, or off; never brighter than it is (an unlit keyboard stays unlit).
  local target=0
  [[ $mode == dim ]] && target=$(min 1 "$cur")
  (( target == cur )) || brightnessctl -q -d "$dev" set "$target" >/dev/null 2>&1
}

# Put the keyboard back and check it; on failure keep the saved level.
keyboard_off() {
  local dev level try got
  dev=$(jq -r '.keyboard.device // ""' <<<"$S")
  level=$(jq -r '.keyboard.level // ""' <<<"$S")
  if [[ -n $dev && $level =~ ^[0-9]+$ && -r $SYSFS/class/leds/$dev/brightness ]]; then
    for try in 1 2 3; do
      brightnessctl -q -d "$dev" set "$level" >/dev/null 2>&1
      got=$(<"$SYSFS/class/leds/$dev/brightness")
      [[ $got == "$level" ]] && { js '.keyboard = null'; return 0; }
      (( try < 3 )) && sleep "0.$(( try * 3 ))"
    done
    js '.keyboard.failedRestores = ((.keyboard.failedRestores // 0) + 1)'
    warn "could not put the keyboard backlight back to $level"
    if [[ $(jq -r '.keyboard.failedRestores' <<<"$S") == 1 ]]; then
      FIRST_FAILURES=$(( FIRST_FAILURES + 1 ))
    else
      js '.keyboard = null'   # second miss in a row: give up on the keyboard
    fi
    return 1
  fi
  js '.keyboard = null'
}

# --- commands ----------------------------------------------------------------

# Night mode treats a screen that is away as if it were still plugged in. Each
# screen it dims keeps a saved entry (its own level, and the level night mode
# set) until night mode puts that level back, however many times it is
# unplugged, replugged on another port, or night mode is turned on and off
# meanwhile. Whenever a screen shows up, it is brought to whatever night mode
# is now: dimmed when it is on, its own level when it is off.
#
# PENDING counts connected screens still left to do because they did not
# answer (a monitor waking up): `sync` exits 75 so the bar tries again.
PENDING=0

# Dim every connected screen to the target; save each level first.
apply_night() {
  local c id level cur
  local -A now=()
  for c in "${CONNECTED[@]}"; do
    id=${D_ID[$c]}
    has_saved "$c" && continue
    if ! cur=$(get_level "$c"); then
      mark_controllable "$c" false
      PENDING=$(( PENDING + 1 ))
      continue
    fi
    now[$c]=$cur
    mark_controllable "$c" true
    js --arg id "$id" --arg c "$c" --arg k "${D_KEY[$c]}" --arg kind "${D_KIND[$c]}" --arg dev "${D_DEV[$c]}" \
      --argjson v "$cur" '.saved[$id] = {key: $k, connector: $c, kind: $kind, device: $dev, level: $v, setLevel: null}'
  done
  compute_target
  local prev original
  for c in "${CONNECTED[@]}"; do
    id=${D_ID[$c]}
    has_saved "$c" || continue
    # Night mode only ever dims: never above the level saved when it turned
    # on, nor above where the screen is now (you may have dimmed it further).
    original=$(saved_original "$c")
    level=$(min "$(night_level "$c")" "$original")
    prev=$(saved_field "$c" setLevel)
    # Read the screen rather than trust setLevel: a monitor that was unplugged,
    # switched off or woken from standby often comes back at its own brightness.
    cur=${now[$c]:-}
    if [[ -z $cur ]] && ! cur=$(get_level "$c"); then
      PENDING=$(( PENDING + 1 ))   # not answering yet: the next sync tries again
      continue
    fi
    if [[ -n $prev ]]; then
      # Darker than night mode left it (you dimmed it further): leave it.
      # Brighter: a monitor that was replugged or power-cycled resets its own
      # brightness, so dim it again. A laptop backlight never resets itself,
      # so a brighter one is you turning it up: leave that too.
      if (( cur > prev )) && [[ ${D_KIND[$c]} == backlight ]]; then
        continue
      fi
      if (( cur <= prev )); then
        level=$(min "$level" "$cur")
        if [[ $level == "$cur" ]]; then
          js --arg id "$id" --argjson l "$level" '.saved[$id].setLevel = $l | del(.saved[$id].failedRestores)'
          continue
        fi
      fi
    elif (( cur <= level )); then
      # Already at or below the night level.
      js --arg id "$id" --argjson l "$cur" '.saved[$id].setLevel = $l'
      continue
    fi
    if apply_level "$c" "$level"; then
      js --arg id "$id" --argjson l "$level" '.saved[$id].setLevel = $l | del(.saved[$id].failedRestores)'
    else
      PENDING=$(( PENDING + 1 ))
      warn "could not dim $c to $level"
    fi
  done
}

saved_original() {
  in_units "$1" "$(saved_field "$1" kind)" "$(saved_field "$1" level)"
}

# Put back every connected screen's saved level and check it took. A screen
# that does not take it keeps its saved level for the next try; screens that
# are away keep theirs until they come back. Counts the first failures.
FIRST_FAILURES=0
restore_saved() {
  local c id kind level dev n
  FIRST_FAILURES=0
  for c in "${CONNECTED[@]}"; do
    id=${D_ID[$c]}
    has_saved "$c" || continue
    kind=$(saved_field "$c" kind)
    level=$(saved_field "$c" level)
    dev=$(saved_field "$c" device)
    [[ $kind == backlight && -z $dev ]] && dev=${D_DEV[$c]:-}
    if apply_level "$c" "$level" "$kind" "$dev"; then
      js --arg id "$id" 'del(.saved[$id])'
    else
      js --arg id "$id" '.saved[$id].failedRestores = ((.saved[$id].failedRestores // 0) + 1)'
      n=$(saved_field "$c" failedRestores)
      (( n == 1 )) && FIRST_FAILURES=$(( FIRST_FAILURES + 1 ))
      PENDING=$(( PENDING + 1 ))
      warn "could not put $c back to $level; it is kept for the next try"
    fi
  done
}

cmd_on() {
  scan
  remember_screens
  apply_night
  keyboard_on
  js '.on = true'
  save_state
}

cmd_off() {
  scan
  restore_saved
  keyboard_off
  # Something missed its level for the first time: stay on, so the moon stays
  # lit and the next click tries again. A second miss in a row lets night mode
  # go off; that screen keeps its saved level for `sync` (a replug) or the next
  # turn on and off, so its own brightness is never lost.
  if (( FIRST_FAILURES > 0 )); then
    save_state
    return 1
  fi
  js '.on = false | .target = null | .reference = null'
  save_state
}

# Bring every connected screen to what night mode is now. Exits 75 when a
# screen did not answer yet, so the bar runs it again a little later.
readonly EX_TRY_AGAIN=75
cmd_sync() {
  scan
  remember_screens
  PENDING=0
  if [[ $(jq -r '.on' <<<"$S") == true ]]; then
    apply_night
  else
    restore_saved
  fi
  save_state
  (( PENDING == 0 )) || return "$EX_TRY_AGAIN"
}

status() { [[ $(jq -r '.on' <<<"$S") == true ]] && echo on || echo off; }

cmd_info() {
  local json=${1:-} c level night matched base now_nits rows=() on target ref ref_name
  scan
  remember_screens
  on=$(status)
  [[ $on == on ]] || compute_target
  target=$(target_nits)
  ref=$(reference_key)
  ref_name=$(jq -r --arg k "$ref" '.displays[$k].name // ""' <<<"$S")

  for c in "${CONNECTED[@]}"; do
    if level=$(get_level "$c"); then
      mark_controllable "$c" true
      now_nits=$(nits_at "$c" "$level")
      matched=$(night_level "$c")
      # Night mode never brightens: it works from the level saved when it
      # turned on, or from where the screen is now.
      base=$level
      has_saved "$c" && base=$(saved_original "$c")
      night=$(min "$matched" "$base")
    else
      mark_controllable "$c" false
      level=""; now_nits=""; night=""; matched=""
    fi
    rows+=("$(jq -cn --arg c "$c" --arg name "${D_DESC[$c]}" --arg control "${D_KIND[$c]}" \
      --arg dev "${D_DEV[$c]}" --argjson max "${D_NITS[$c]}" --arg src "${D_SRC[$c]}" \
      --argjson levelMax "${D_MAX[$c]}" --arg level "$level" --arg now "$now_nits" \
      --arg night "$night" --arg matched "$matched" --argjson trim "$(trim_of "$c")" \
      --argjson low "$(nits_at "$c" "$(lowest_level "$c")")" '
      {connector: $c, name: $name, control: $control, device: $dev, maxNits: $max,
       source: $src, levelMax: $levelMax, nitsAtLowest: $low, trim: $trim,
       level: ($level | tonumber? // null), nits: ($now | tonumber? // null),
       nightLevel: ($night | tonumber? // null), matchedLevel: ($matched | tonumber? // null),
       keepsOwnLevel: (($night | tonumber? // 0) < ($matched | tonumber? // 0))}')")
  done
  save_state

  if [[ $json == --json ]]; then
    printf '%s\n' "${rows[@]}" | jq -s --arg on "$on" --argjson t "$target" --arg ref "$ref_name" \
      '{on: ($on == "on"), targetNits: $t, reference: (if $ref == "" then null else $ref end), screens: .}'
    return
  fi

  local how="automatic" r
  awk -v x="$(target_setting)" 'BEGIN { exit !(x > 0) }' && how="set in shell.json"
  printf 'Night mode %s · %s cd/m² (%s' "$on" "$(fmt_nits "$target")" "$how"
  [[ -n $ref_name && $how == automatic ]] && printf ': %s at 1 %%' "$ref_name"
  printf ')\n'
  for r in "${rows[@]}"; do
    jq -r --arg floor "$(awk -v f="$PERCENT_FLOOR" 'BEGIN { print f * 100 }')" '
      def n: if . >= 10 then (. | round | tostring) else ((. * 10 | round) / 10 | tostring) end;
      def lvl($l): if .control == "backlight" then "\($l)/\(.levelMax)" else "\($l) %" end;
      "",
      "\(.connector)  \(.name)",
      "  control   " + (if .control == "backlight" then "backlight \(.device) (0-\(.levelMax))" else "DDC/CI or Apple display (1-100 %)" end),
      "  maximum   \(.maxNits | n) cd/m² (\(.source))",
      "  at 1 %    \(.nitsAtLowest | n) cd/m²" + (if .control == "backlight" then "" else " (assumes \($floor) % of maximum at 0 %)" end),
      (if .level == null then "  now       brightness cannot be read or set (no DDC/CI)"
       else "  now       \(lvl(.level)) · \(.nits | n) cd/m²" end),
      (if .nightLevel == null then empty
       elif .keepsOwnLevel then "  night     \(lvl(.nightLevel)) (already darker than the night level, \(lvl(.matchedLevel)), so it stays)"
       else "  night     \(lvl(.nightLevel))" end),
      (if .trim != 1 then "  calibrated ×\(.trim * 100 | round / 100)" else empty end)
    ' <<<"$r"
  done
  printf '\nScreens that do not look alike at night: night-mode calibrate\n'
}

read_key() {
  local k rest
  IFS= read -rsn1 k || return 1
  if [[ $k == $'\e' ]]; then
    IFS= read -rsn2 -t 0.05 rest || rest=""
    k+=$rest
  fi
  case $k in
  $'\e[A' | $'\e[C' | k | l | + | =) echo up ;;
  $'\e[B' | $'\e[D' | j | h | -) echo down ;;
  '' | $'\n' | $'\r') echo save ;;
  $'\e' | q | Q) echo cancel ;;
  *) echo other ;;
  esac
}

cmd_calibrate() {
  [[ -t 0 && -t 1 ]] || die "calibrate needs a terminal"
  local was_on c ref candidates=() choice trim old_trim level key
  was_on=$(status)
  cmd_on
  load_state
  scan
  ref=$(reference_key)
  for c in "${CONNECTED[@]}"; do
    has_saved "$c" || continue
    [[ ${D_KEY[$c]} == "$ref" ]] && continue
    if (( $(saved_original "$c") < $(night_level "$c") )); then
      printf '%s was already darker than the night level, so night mode leaves it where you had it.\n' "$c"
      continue
    fi
    candidates+=("$c")
  done

  if (( ${#CONNECTED[@]} < 2 || ${#candidates[@]} == 0 )); then
    echo "Calibrating matches screens to each other, so it needs two dimmable screens connected."
    [[ $was_on == off ]] && cmd_off
    return 0
  fi

  local ref_name
  ref_name=$(jq -r --arg k "$ref" '.displays[$k].name // "the target"' <<<"$S")
  for c in "${candidates[@]}"; do
    printf '\nNight mode is on. Look at %s (%s) and %s side by side.\n' "${D_DESC[$c]}" "$c" "$ref_name"
    printf 'Up / Down to make %s brighter or dimmer, Enter to save, Esc to cancel.\n\n' "$c"
    old_trim=$(trim_of "$c"); trim=$old_trim
    local own
    own=$(saved_original "$c")
    while :; do
      level=$(min "$(level_for "$c" "$(calc "$(target_nits) * $trim")")" "$own")
      printf '\r\e[K  %s: %s cd/m² (level %s)' "$c" "$(fmt_nits "$(nits_at "$c" "$level")")" "$level"
      [[ $level == "$own" ]] && printf ' (your own level: night mode goes no brighter)'
      choice=$(read_key) || choice=cancel
      case $choice in
      up) trim=$(calc "$trim * $CALIBRATE_STEP") ;;
      down) trim=$(calc "$trim / $CALIBRATE_STEP") ;;
      save)
        key=${D_KEY[$c]}
        js --arg k "$key" --argjson t "$trim" '.displays[$k].trim = $t'
        js --arg id "${D_ID[$c]}" --argjson l "$level" '.saved[$id].setLevel = $l'
        save_state
        printf '\n  Saved.\n'
        break ;;
      cancel)
        trim=$old_trim
        set_level "$c" "$(min "$(level_for "$c" "$(calc "$(target_nits) * $trim")")" "$own")"
        printf '\n  Cancelled.\n'
        break ;;
      *) continue ;;
      esac
      set_level "$c" "$(min "$(level_for "$c" "$(calc "$(target_nits) * $trim")")" "$own")"
    done
  done
  [[ $was_on == off ]] && cmd_off
  return 0
}

cmd_forget() {
  local what=${1:-all}
  if [[ $what == all ]]; then
    js '.displays = {}'
  else
    scan
    local key=${D_KEY[$what]:-}
    [[ -n $key ]] || die "no connected screen called $what"
    js --arg k "$key" 'del(.displays[$k])'
  fi
  save_state
  echo "Forgot $what."
}

main() {
  local cmd=${1:-toggle}
  case $cmd in
  -h | --help | help) usage; return 0 ;;
  -v | --version | version) echo "night-mode $VERSION"; return 0 ;;
  esac

  have jq || die "jq not found"
  mkdir -p "$STATE_DIR"
  local asked started rc=0 last_start last_rc
  asked=$(date +%s%N)
  exec {lock}>"$STATE_DIR/lock"
  flock -w 20 "$lock" || die "another night-mode run is stuck"
  started=$(date +%s%N)

  load_state
  case $cmd in
  on) [[ $(status) == on ]] || cmd_on ;;
  off) cmd_off ;;
  toggle) if [[ $(status) == on ]]; then cmd_off; else cmd_on; fi ;;
  status) ;;
  sync)
    # The bar lives once per screen, so a plug or unplug asks for a sync from
    # each copy. One that started after this one was asked for has already
    # looked at every screen: take its result instead of asking them again.
    if read -r last_start last_rc 2>/dev/null <"$STATE_DIR/last-sync" &&
      [[ $last_start =~ ^[0-9]+$ && $last_rc =~ ^[0-9]+$ ]] && (( last_start > asked )); then
      rc=$last_rc
    else
      cmd_sync; rc=$?
      printf '%s %s\n' "$started" "$rc" >"$STATE_DIR/last-sync"
    fi
    ;;
  info) cmd_info "${2:-}"; return 0 ;;
  calibrate) cmd_calibrate; return 0 ;;
  forget) cmd_forget "${2:-all}"; return 0 ;;
  *) usage >&2; return 2 ;;
  esac
  status
  return "$rc"
}

main "$@"
